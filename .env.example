# ─── Docker Compose image tags ────────────────────────────────────────────────
# Set these to the exact image tags you want docker compose to pull.
# Copy this file to .env and fill in values before running docker compose up.

# Kafka broker image (KRaft mode — no ZooKeeper required)
KAFKA_IMAGE=confluentinc/cp-kafka:7.6.1

# Stable cluster ID for KRaft — generate once with:
#   docker run --rm confluentinc/cp-kafka:7.6.1 kafka-storage random-uuid
# Leave the default for local development; set to a fresh UUID in production.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Apache Flink image (jobmanager + taskmanager)
# Must match the flink.version in event-rule-backend/pom.xml (currently 2.2.0).
# Java 21 is required by target.java.version in pom.xml.
# Changing this to a 1.x image will cause Flink to become stuck in INITIALIZING
# because the flink-connector-kafka 4.0.0-2.0 Writer/Committer checkpoint protocol
# is incompatible with the Flink 1.x runtime.
FLINK_IMAGE=flink:2.2.0-scala_2.12-java21

# ─── BFF runtime ──────────────────────────────────────────────────────────────

# Kafka bootstrap servers visible to the BFF (Node.js)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# HTTP port the BFF listens on
PORT=8080

# Comma-separated list of allowed CORS origins for the BFF.
# In production set this to the exact origin(s) your UI is served from,
# e.g. "https://event-rule.example.com".  Defaults to http://localhost:3010
# (the Vite dev server) when unset.
# ALLOWED_ORIGINS=http://localhost:3010

# Absolute path to the samples directory
# SAMPLES_DIR=/app/samples

# Flink REST API base URL (leave blank to disable job management)
# FLINK_URL=http://localhost:8081

# Absolute path to the fat JAR used by the BFF for sample-input generation
# JAR_PATH=/app/flink-jars/event-rule-backend-1.0-SNAPSHOT.jar

# Kafka topic defaults
TOPIC_PARTITIONS=3
TOPIC_REPLICATION_FACTOR=1

# ─── Flink job runtime ────────────────────────────────────────────────────────

# Kafka bootstrap servers visible to the Flink task managers
# (usually the internal Docker network address, not localhost:9092)
# KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Flink job display name (overrides the AgentDescriptor default)
# FLINK_JOB_NAME=Event Rule Agent

# Flink operator parallelism (0 = use Flink cluster default)
# FLINK_PARALLELISM=1

# Checkpoint timeout in milliseconds (default: 300000 = 5 minutes).
# Must be ≥ the time needed to initialize all operators (DI archive pre-warm, etc.)
# CHECKPOINT_TIMEOUT_MS=300000

# Delay before the FIRST checkpoint fires after job submission (default: 300000 = 5 minutes).
# Set this to cover the full cold-start warm-up window:
#   • RocksDB native-library extraction from the JAR to /tmp  (~6–10 s on native JVM)
#   • IBM DI runner pre-warm for each agent operation           (~10–30 s per op on native JVM)
# Both are now run on a background thread in StatefulAgentProcessor so the Flink task
# reaches RUNNING quickly; this delay is a belt-and-suspenders guard for the first checkpoint.
# On Apple Silicon with an amd64 Docker image (QEMU emulation) warm-up can take 5–10 min;
# switch FLINK_IMAGE to flink:2.2.0-scala_2.12-java21 (native arm64) to reduce this to <30 s.
# CHECKPOINT_INITIAL_DELAY_MS=300000

# Global in-process agent chaining kill switch.
# Set to "false" to disable direct in-process agent-to-agent chaining for ALL agents,
# regardless of what individual agent descriptors declare via the "chainingEnabled" field.
# Set to "true" (or leave unset) to respect each agent's own "chainingEnabled" field (default: true).
# Only the literal value "false" (case-insensitive) disables chaining; all other values enable it.
# CHAINING_ENABLED=true

# ─── Flink archive hot-swap ──────────────────────────────────────────────────

# Directory where downloaded Decision Intelligence archives are cached.
# Defaults to the JVM temp dir if unset.
# FLINK_ARCHIVE_CACHE_DIR=/tmp/di-archive-cache

# ─── Deployment API server (embedded in Flink job) ───────────────────────────

# Port the embedded deployment REST API listens on (default: 9090)
# DEPLOY_API_PORT=9090

# ─── IBM DI Runtime integration ─────────────────────────────────────────────
#
# JSON array of IBM Decision Intelligence runtime instances the BFF may proxy
# for the Descriptor Wizard "Fetch from DI Runtime" workflow.
#
# Each entry supports the following fields:
#   id                  (required) unique key used in BFF API routes
#   name                (required) display label shown in the wizard
#   url                 (required) base URL of the DI Runtime (no trailing slash)
#   username            (optional) HTTP Basic auth username
#   password            (optional) HTTP Basic auth password
#   deploymentSpace     (optional) deployment space name; defaults to "embedded"
#   rejectUnauthorized  (optional) set to false to allow self-signed / internal TLS certs
#
# Credentials are consumed server-side only and are NEVER sent to the browser.
#
# The BFF calls:
#   GET  <url>/ads/runtime/api/v1/deploymentSpaces/<space>/decisions?exposed=false
#   GET  <url>/ads/runtime/api/v1/deploymentSpaces/<space>/decisions/<decisionId>/archive
#
# Example (Fyre/internal cluster with self-signed cert):
# DI_RUNTIMES=[{"id":"di-dev","name":"DI Dev (Fyre)","url":"https://xxxxxxx.fyre.ibm.com","username":"xxxxx","password":"xxxxxxx","deploymentSpace":"xxxxx","rejectUnauthorized":false}]

# Log files generated when ${sys:log.file} is unset (e.g. during local Maven builds/tests)
# Log4j2 resolves the literal string "${sys:log.file}" when the system property is not set,
# creating a file with that name in the working directory.
\${sys:log.file}
\${sys:log.file}.*
*.log
*.log.*

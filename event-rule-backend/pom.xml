<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ibm.di.event</groupId>
        <artifactId>event-rule-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>event-rule-backend</artifactId>
    <packaging>jar</packaging>

    <name>Event Rule Backend</name>
    <description>Flink-based backend for event processing</description>

    <properties>
        <flink.version>2.2.0</flink.version>
        <log4j.version>2.24.3</log4j.version>
        <target.java.version>21</target.java.version>
        <!--
            jackson.version, foundation.version, execution.api.version, and
            engine.de.api.version are managed in the parent pom.xml
            <dependencyManagement> block and must not be redefined here.
            Update the versions there when the Decision Designer instance changes.
        -->
    </properties>

    <profiles>
        <!--
            Development profile — for local IDE / exec:java runs.
            All Flink dependencies are currently compile-scoped in the main <dependencies>
            block (required because the application is packaged as a self-contained fat JAR
            and the Flink image does not supply the Kafka connector or IBM libraries).
            If the Flink dependencies are ever changed to provided scope (e.g. when targeting
            a cluster that pre-installs them), add compile-scope overrides here so that
            `mvn exec:java -Pdev` and IDE runs still have the full classpath.
        -->
        <profile>
            <id>dev</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
        </profile>

        <!-- Functional profile — runs BFF and Flink integration tests that require a
             live Docker Compose stack (Kafka + Flink + BFF).
             Activate with:  mvn verify -pl event-rule-backend -Pfunctional
             Requirements: ./run.sh up  (stack must already be running) -->
        <profile>
            <id>functional</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.2.5</version>
                        <configuration>
                            <includes>
                                <include>**/functional/**/*Test.java</include>
                                <include>**/functional/**/*Tests.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <log.file>${project.build.directory}/test-logs/functional-test.log</log.file>
                                <FUNCTIONAL_TESTS_ENABLED>true</FUNCTIONAL_TESTS_ENABLED>
                            </systemPropertyVariables>
                        </configuration>
                        <executions>
                            <execution>
                                <id>functional-integration-test</id>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- E2E profile — runs the Banking Fraud Agent end-to-end test.
             Requires the Docker Compose stack and the deployed Event Rule application.
             Activate with:  mvn verify -pl event-rule-backend -Pe2e  (settings.xml not needed)
             Or:             mvn failsafe:integration-test -pl event-rule-backend -Pe2e -->
        <profile>
            <id>e2e</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.2.5</version>
                        <executions>
                            <execution>
                                <id>e2e-integration-test</id>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Confluent Cloud profile — builds the two things a use case needs to run as a Process
            Table Function on Confluent Cloud for Apache Flink:
              1. the function JAR (artifact), and
              2. the SQL program that registers it and starts the pipeline.

            Activate with (from the repository root):
              mvn -f event-rule-backend package -DskipTests -Pccloud \
                  -Dccloud.descriptor=samples/banking-fraud-agent/agents.json \
                  -Dccloud.name=banking-fraud-agent

            Everything is written to event-rule-backend/target/ccloud/, a directory of its own so that
            the standard build output (target/) is never mixed with it:
              <ccloud.name>.jar   the function JAR (upload with `confluent flink artifact create`)
              sql/NNN-*.sql       one statement per file, in execution order
              pipeline.sql        the same program as one script (for the SQL workspace)
              manifest.json       the statements in execution order, and the artifact, for a script

            Differences with the standard fat JAR:
              - the Flink runtime, the connectors and Log4j are 'provided': Confluent Cloud supplies
                them, and bundling a second copy risks class conflicts and a very large artifact;
              - the ruleset archives and the reference-data CSV files named in the descriptor are
                copied into the JAR (there is no volume to mount), see ConfluentCloudPackager.
            Pass -Dccloud.artifactUri=confluent-artifact://<artifact-id>/<version-id> to write the
            artifact in the CREATE FUNCTION statements; without it the placeholder is kept and the
            deployment script substitutes it after the upload.
        -->
        <profile>
            <id>ccloud</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <properties>
                <!-- agents.json of the use case; required -->
                <ccloud.descriptor></ccloud.descriptor>
                <!-- name of the JAR; the use case directory name is a good value -->
                <ccloud.name>event-rule-ccloud</ccloud.name>
                <!-- directory the paths of the descriptor are relative to: the repository root -->
                <ccloud.baseDir>${project.basedir}/..</ccloud.baseDir>
                <ccloud.artifactUri></ccloud.artifactUri>
            </properties>
            <build>
                <directory>${project.basedir}/target/ccloud</directory>
                <finalName>${ccloud.name}</finalName>
                <plugins>
                    <!-- Copies the runtime files into the JAR and writes the SQL program -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>ccloud-package</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>java</goal>
                                </goals>
                                <configuration>
                                    <mainClass>com.ibm.di.event.agent.ptf.ConfluentCloudPackager</mainClass>
                                    <!-- 'compile' includes the provided dependencies the packager needs -->
                                    <classpathScope>compile</classpathScope>
                                    <systemProperties>
                                        <systemProperty>
                                            <key>ccloud.descriptor</key>
                                            <value>${ccloud.descriptor}</value>
                                        </systemProperty>
                                        <systemProperty>
                                            <key>ccloud.baseDir</key>
                                            <value>${ccloud.baseDir}</value>
                                        </systemProperty>
                                        <systemProperty>
                                            <key>ccloud.classesDir</key>
                                            <value>${project.build.outputDirectory}</value>
                                        </systemProperty>
                                        <systemProperty>
                                            <key>ccloud.outDir</key>
                                            <value>${project.build.directory}</value>
                                        </systemProperty>
                                        <systemProperty>
                                            <key>ccloud.jar</key>
                                            <value>${ccloud.name}.jar</value>
                                        </systemProperty>
                                        <systemProperty>
                                            <key>ccloud.artifactUri</key>
                                            <value>${ccloud.artifactUri}</value>
                                        </systemProperty>
                                    </systemProperties>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!--
                        Minimal set of IBM libraries to execute a ruleset: execution-api, engine-de-api
                        (with its annotations dependency), jackson-databind (with its transitive
                        dependencies) and jackson-datatype-jsr310. So, compared with the standard fat JAR:
                          - 'foundation' (80 MB uber JAR) is not bundled: it is 'provided' below. The
                            classes the module uses are in engine-de-api; AbstractDecisionProvider, which
                            only foundation has, is loaded from the ruleset archive (RuleEngineRunner).
                          - 'ml-integration-runtime' (execution-api's transitive dependency, 36 MB: the
                            Decision ML integration, with the AWS SDK) is not bundled. A ruleset that scores
                            a machine-learning model needs it: remove it from the excludes below then.
                          - engine-de-api and annotations are bundled: the standard configuration excludes
                            them only because foundation already contains them.
                        'override' replaces the artifactSet of the standard shade configuration.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>shade</goal>
                                </goals>
                                <configuration>
                                    <artifactSet combine.self="override">
                                        <excludes>
                                            <exclude>com.ibm.decision:ml-integration-runtime</exclude>
                                        </excludes>
                                    </artifactSet>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
            <!-- Supplied by Confluent Cloud at runtime: compile against them, do not bundle them.
                 These entries override the compile-scoped ones of the main <dependencies>. -->
            <dependencies>
                <!-- Not needed to execute a ruleset, see the shade plugin comment above -->
                <dependency>
                    <groupId>com.ibm.decision</groupId>
                    <artifactId>foundation</artifactId>
                    <scope>provided</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.flink</groupId>
                    <artifactId>flink-core</artifactId>
                    <version>${flink.version}</version>
                    <scope>provided</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.flink</groupId>
                    <artifactId>flink-streaming-java</artifactId>
                    <version>${flink.version}</version>
                    <scope>provided</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.flink</groupId>
                    <artifactId>flink-clients</artifactId>
                    <version>${flink.version}</version>
                    <scope>provided</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.flink</groupId>
                    <artifactId>flink-connector-kafka</artifactId>
                    <version>4.0.0-2.0</version>
                    <scope>provided</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.flink</groupId>
                    <artifactId>flink-connector-base</artifactId>
                    <version>${flink.version}</version>
                    <scope>provided</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.flink</groupId>
                    <artifactId>flink-table-api-java-bridge</artifactId>
                    <version>${flink.version}</version>
                    <scope>provided</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.flink</groupId>
                    <artifactId>flink-table-planner-loader</artifactId>
                    <version>${flink.version}</version>
                    <scope>provided</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.flink</groupId>
                    <artifactId>flink-table-runtime</artifactId>
                    <version>${flink.version}</version>
                    <scope>provided</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.flink</groupId>
                    <artifactId>flink-csv</artifactId>
                    <version>${flink.version}</version>
                    <scope>provided</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.flink</groupId>
                    <artifactId>flink-json</artifactId>
                    <version>${flink.version}</version>
                    <scope>provided</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.flink</groupId>
                    <artifactId>flink-connector-files</artifactId>
                    <version>${flink.version}</version>
                    <scope>provided</scope>
                </dependency>
                <!-- Confluent Cloud logs UDFs through Log4j only (the platform provides it) -->
                <dependency>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                    <version>2.0.13</version>
                    <scope>provided</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j2-impl</artifactId>
                    <version>${log4j.version}</version>
                    <scope>provided</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-api</artifactId>
                    <version>${log4j.version}</version>
                    <scope>provided</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-core</artifactId>
                    <version>${log4j.version}</version>
                    <scope>provided</scope>
                </dependency>
            </dependencies>
        </profile>

    </profiles>

    <repositories>

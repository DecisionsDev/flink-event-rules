<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ibm.di.event</groupId>
        <artifactId>event-rule-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>event-rule-frontend</artifactId>
    <packaging>pom</packaging>

    <name>Event Rule Frontend</name>
    <description>React frontend and Node.js BFF for Event Rule application</description>

    <build>
        <plugins>
            <!--
                frontend-maven-plugin installs a project-local Node/npm and runs
                the npm lifecycle for both the React app and the BFF.
                This lets `mvn test` or `mvn verify` validate the entire stack.
            -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <configuration>
                    <!-- Install into the module directory so builds are self-contained -->
                    <installDirectory>${project.basedir}/.mvn-node</installDirectory>
                    <nodeVersion>v20.18.0</nodeVersion>
                    <npmVersion>10.8.2</npmVersion>
                </configuration>
                <executions>
                    <!-- 1. Install Node + npm locally (cached; no-op on subsequent runs) -->
                    <execution>
                        <id>install-node-and-npm</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>${project.basedir}</workingDirectory>
                        </configuration>
                    </execution>

                    <!-- 2. Install frontend dependencies -->
                    <execution>
                        <id>frontend-npm-install</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>ci</arguments>
                        </configuration>
                    </execution>

                    <!-- 3. Install BFF dependencies -->
                    <execution>
                        <id>bff-npm-install</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>${project.basedir}/bff</workingDirectory>
                            <arguments>ci</arguments>
                        </configuration>
                    </execution>

                    <!-- 4. Run frontend tests (Vitest) -->
                    <execution>
                        <id>frontend-npm-test</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>test</arguments>
                        </configuration>
                    </execution>

                    <!-- 5. Build the React app (Vite) -->
                    <execution>
                        <id>frontend-npm-build</id>
                        <phase>package</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

{
  "name": "Transport — Airline Agent",
  "flinkJobName": "Airline Agent",
  "description": "Event Rules Application for Real-Time operation of an airline. Process airline events to notify systems and passenger about flight-related events.",
  "consumerGroupId": "event-rule-bff-airline-agent",
  "topics": [
    {
      "name": "agent-flight-events",
      "type": "FlightEvent",
      "label": "Flight Events",
      "schema": "samples/airline-agent/schemas/flight-event.schema.json"
    },
    {
      "name": "agent-catering-events",
      "type": "CateringEvent",
      "label": "Catering Events"
    },
    {
      "name": "agent-passenger-events",
      "type": "PassengerEvent",
      "label": "Passenger Events",
      "idleness": "30s"
    }
  ],
  "agents": [
    {
      "agentId": "airline-agent",
      "name": "Airline Agent",
      "entityType": "Flight",
      "entityKeyExtractor": "$.flightNumber",
      "chainingEnabled": true,
      "references": [
        { "name": "flights",    "type": "csv", "file": "samples/airline-agent/enrichment/flights.csv" },
        { "name": "passengers", "type": "csv", "file": "samples/airline-agent/enrichment/passengers.csv" },
        { "name": "catering",   "type": "csv", "file": "samples/airline-agent/enrichment/catering.csv" },
        { "name": "roster",     "type": "csv", "file": "samples/airline-agent/enrichment/flight_passengers.csv" }
      ],
      "subscriptions": [
        {
          "eventType": "FlightEvent",
          "topic": "agent-flight-events",
          "operation": "ProcessFlightEvent",
          "horizon": {
            "type": "time",
            "timeLimit": "96h",
            "description": "Keep 96 hours of Flight Events per flight"
          },
          "sqlEnrichment": {
            "sqlFile": "samples/airline-agent/enrichment/enrich_flight_events.sql",
            "inputViewName": "raw_flight_events",
            "outputViewName": "enriched_flight_events"
          },
          "enrichment": [
            { "reference": "flights", "key": "flightNumber", "on": "$.flightNumber",
              "when": "$[?(@.type == 'FLIGHTOPEN')]",
              "into": "$.flight",
              "fields": ["flightNumber", "aircraftId", "aircraftType", "date", "origin", "destination", "duration"] },
            { "reference": "catering", "key": "flightNumber", "on": "$.flightNumber",
              "when": "$[?(@.type == 'FLIGHTOPEN')]",
              "into": "$.flight.cateringInformation",
              "fields": ["economyTotalMealCount", "businessTotalMealCount", "firstTotalMealCount"] },
            { "reference": "roster", "key": "flightNumber", "on": "$.flightNumber",
              "when": "$[?(@.type == 'FLIGHTOPEN')]",
              "into": "$.flight.passengers", "cardinality": "many",
              "fields": ["passengerId", { "checkInStatus": "check-inStatus" }, "travelClass"] },
            { "reference": "passengers", "key": "passengerId", "on": "$.passengerId",
              "into": "$.flight.passengers[*]",
              "fields": ["name", "birthdate", "citizenship", "residenceCountry", "loyaltyStatus"] }
          ]
        },
        {
          "eventType": "CateringEvent",
          "topic": "agent-catering-events",
          "operation": "ProcessCateringEvent",
          "horizon": {
            "type": "hybrid",
            "countLimit": 100,
            "timeLimit": "96h",
            "description": "Keep last 100 catering events or 96 hours of history per flight"
          }
        },
        {
          "eventType": "PassengerEvent",
          "topic": "agent-passenger-events",
          "operation": "ProcessPassengerEvent",
          "horizon": {
            "type": "time",
            "timeLimit": "96h",
            "description": "Keep last 96 hours of history per flight"
          }
        },
        {
          "eventType": "Schedule",
          "operation": "ProcessSchedule"
        }
      ],
      "ruleset": {
        "path": "samples/airline-agent/AirlineDecisionService_1.2.6.jar",
        "archiveControlTopic": "agent-airline-archive-control",
        "operations": [
          {
            "operation": "ProcessFlightEvent",
            "entityField": "flight",
            "currentEventField": "flightEvent",
            "history": [
              {
                "eventType": "FlightEvent",
                "field": "pastFlightEvents"
              }
            ],
            "outbounds": [
              {
                "field": "flightNotifications",
                "eventType": "FlightNotification"
              },
              {
                "field": "passengerNotifications",
                "eventType": "PassengerNotification"
              }
            ],
            "scheduleRequestsField": "scheduleRequests"
          },
          {
            "operation": "ProcessPassengerEvent",
            "entityField": "flight",
            "currentEventField": "passengerEvent",
            "history": [
              {
                "eventType": "PassengerEvent",
                "field": "pastPassengerEvents"
              }
            ],
            "outbounds": [
              {
                "field": "flightNotifications",
                "eventType": "FlightNotification"
              },
              {
                "field": "passengerNotifications",
                "eventType": "PassengerNotification"
              }
            ],
            "scheduleRequestsField": "scheduleRequests"
          },
          {
            "operation": "ProcessCateringEvent",
            "entityField": "flight",
            "currentEventField": "cateringEvent",
            "history": [
              {
                "eventType": "CateringEvent",
                "field": "pastCateringEvents"
              }
            ],
            "outbounds": [
              {
                "field": "flightNotifications",
                "eventType": "FlightNotification"
              }
            ],
            "scheduleRequestsField": "scheduleRequests"
          },
          {
            "operation": "ProcessSchedule",
            "entityField": "flight",
            "currentEventField": "schedule",
            "history": [
              {
                "eventType": "FlightEvent",
                "field": "pastFlightEvents"
              }
            ],
            "outbounds": [
              {
                "field": "flightNotifications",
                "eventType": "FlightNotification"
              },
              {
                "field": "passengerNotifications",
                "eventType": "PassengerNotification"
              }
            ],
            "scheduleRequestsField": "scheduleRequests"
          }
        ]
      },
      "outputs": [
        {
          "eventType": "FlightNotification",
          "topic": "agent-flight-notifications",
          "label": "Flight Notifications",
          "description": "Real-time flight notification"
        },
        {
          "eventType": "PassengerNotification",
          "topic": "agent-passenger-notifications",
          "label": "Passenger Notifications",
          "description": "Real-time passenger notification",
          "schema": "samples/airline-agent/schemas/passenger-notification.schema.json",
          "sqlEnrichment": {
            "sqlFile": "samples/airline-agent/enrichment/enrich_passenger_notifications.sql",
            "inputViewName": "raw_passenger_notifications",
            "outputViewName": "enriched_passenger_notifications"
          },
          "enrichment": [
            { "reference": "passengers", "key": "passengerId", "on": "$.passengerNumber",
              "into": "$",
              "fields": ["name", "loyaltyStatus", "email", "phone", "contactPreference"] }
          ]
        },
        {
          "eventType": "agent-error",
          "topic": "agent-airline-errors",
          "label": "Agent Errors",
          "description": "Processing errors and unparseable events"
        }
      ],
      "stateConfig": {
        "ttl": "7m",
        "backend": "rocksdb",
        "changeLogTopic": "agent-flight-entity-changelog"
      }
    }
  ]
}
